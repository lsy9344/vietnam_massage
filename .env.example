# ---------------------------------------------------------------------------
# 로컬 개발 (.env.local 로 복사해서 사용)
# ---------------------------------------------------------------------------
# 로컬 Postgres (Docker) 기준 값. 운영(Neon) 값과 헷갈리지 않게 분리한다.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vietnam_aesthetic"
# 로컬에서는 pooler가 없으므로 DATABASE_URL 과 동일하게 둔다.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vietnam_aesthetic"

NEXTAUTH_SECRET="replace-with-local-secret"
NEXTAUTH_URL="http://localhost:3000"
# DB 전환 점검 시간에만 read-only로 설정한다. 평소에는 비워 둔다.
MAINTENANCE_MODE=""

# ---------------------------------------------------------------------------
# 운영 (Cloudflare Workers + PlanetScale Postgres)
# 값은 파일에 커밋하지 말고 Cloudflare/GitHub Secrets에만 등록한다.
# ---------------------------------------------------------------------------
# 런타임 DB 연결은 wrangler.jsonc의 HYPERDRIVE 바인딩이 제공한다.
# DIRECT_DATABASE_URL : PlanetScale 직접 연결 문자열. GitHub Actions의 prisma migrate deploy 전용
#                       예) postgresql://USER:PASS@HOST/dbname?sslmode=require
# NEXTAUTH_SECRET     : `openssl rand -base64 32` 로 생성해 `wrangler secret put NEXTAUTH_SECRET`로 등록
# NEXTAUTH_URL        : 배포 도메인. 예) https://erp.example.com
# MAINTENANCE_MODE    : DB 최종 이전 중 Vercel에만 `read-only`로 설정해 쓰기를 차단
#
# 전환 전 롤백 기간에는 기존 Vercel/Neon 환경 변수를 그대로 유지한다.
