generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserAccount {
  id                                         String                              @id @default(cuid())
  email                                      String                              @unique
  accountId                                  String                              @unique @map("account_id")
  passwordHash                               String                              @map("password_hash")
  role                                       String
  employeeId       String?        @unique @map("employee_id")
  employee                                   Employee?                           @relation(fields: [employeeId], references: [id])
  isActive       Boolean    @default(true) @map("is_active")
  lockedUntil                                DateTime?                           @map("locked_until")
  failedLoginCount                           Int                                 @default(0) @map("failed_login_count")
  createdAt                                  DateTime                            @default(now()) @map("created_at")
  updatedAt                                  DateTime                            @updatedAt @map("updated_at")
  loginAttempts                              LoginAttempt[]
  changedServiceCallStatusHistories ServiceCallStatusHistory[]
  confirmedMonthlyClosings MonthlyClosing[]
  changedMigrationVerificationIssueHistories MigrationVerificationIssueHistory[]
  therapistDailySettlementPayments TherapistDailySettlementPayment[]
  changedTherapistDailySettlementPaymentHistories TherapistDailySettlementPaymentHistory[]
  payoutConfirmationEvents PayoutConfirmationEvent[]
  authoredTherapistNotices TherapistNotice[] @relation("TherapistNoticeAuthor")
  withdrawnTherapistNotices TherapistNotice[] @relation("TherapistNoticeWithdrawnBy")
  authoredTherapistInternalMemos TherapistInternalMemo[]

  @@map("user_accounts")
}

model Employee {
  id                     String                  @id @default(cuid())
  displayName            String                  @map("display_name")
  staffCode              String                  @unique @map("staff_code")
  employeeGroup          String                  @map("employee_group")
  position               String
  shiftType              String?                 @map("shift_type")
  baseSalary             Int                     @map("base_salary")
  phone                  String?
  birthday               DateTime?               @db.Date
  hireDate               DateTime?               @map("hire_date") @db.Date
  employmentStatus       String                  @default("재직") @map("employment_status")
  sortOrder              Int                     @map("sort_order")
  isActive               Boolean                 @default(true) @map("is_active")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  account                UserAccount?
  therapistRates         TherapistCourseRate[]
  serviceCallAssignments ServiceCallAssignment[]
  handledDailyExpenses   DailyExpense[]
  opsAttendances         OpsAttendance[]
  therapistAttendances   TherapistAttendance[]
  therapistDailySettlementPayments TherapistDailySettlementPayment[]
  plannedWorkingDays     PlannedWorkingDay[]
  payoutConfirmationEvents PayoutConfirmationEvent[]
  targetedTherapistNotices TherapistNotice[]
  therapistNoticeRecipients TherapistNoticeRecipient[]
  therapistInternalMemos TherapistInternalMemo[]

  @@unique([employeeGroup, sortOrder], map: "uq_employees_employee_group_sort_order")
  @@map("employees")
}

model LoginAttempt {
  id            String       @id @default(cuid())
  userAccountId String?      @map("user_account_id")
  userAccount   UserAccount? @relation(fields: [userAccountId], references: [id])
  identity      String
  success       Boolean
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("login_attempts")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String   @map("actor_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@index([targetType, targetId], map: "idx_audit_logs_target_type_target_id")
  @@index([action], map: "idx_audit_logs_action")
  @@map("audit_logs")
}

model MigrationVerificationIssue {
  id                 String                              @id @default(cuid())
  itemKey            String                              @unique @map("item_key")
  kind               String
  sourceSheet        String?                             @map("source_sheet")
  relatedRequirement String?                             @map("related_requirement")
  relatedStory       String?                             @map("related_story")
  status             String
  assigneeName       String?                             @map("assignee_name")
  note               String?                             @db.VarChar(500)
  createdAt          DateTime                            @default(now()) @map("created_at")
  updatedAt          DateTime                            @updatedAt @map("updated_at")
  histories          MigrationVerificationIssueHistory[]

  @@index([kind, status], map: "idx_migration_verification_issues_kind_status")
  @@index([sourceSheet], map: "idx_migration_verification_issues_source_sheet")
  @@map("migration_verification_issues")
}

model MigrationVerificationIssueHistory {
  id                 String                     @id @default(cuid())
  issueId            String                     @map("issue_id")
  issue              MigrationVerificationIssue @relation(fields: [issueId], references: [id])
  previousStatus     String?                    @map("previous_status")
  newStatus          String                     @map("new_status")
  note               String?                    @db.VarChar(500)
  changedByAccountId String                     @map("changed_by_account_id")
  changedByAccount   UserAccount                @relation(fields: [changedByAccountId], references: [id])
  changedAt          DateTime                   @default(now()) @map("changed_at")
  createdAt          DateTime                   @default(now()) @map("created_at")

  @@index([issueId, changedAt], map: "idx_migration_verification_histories_issue_changed")
  @@index([changedByAccountId, changedAt], map: "idx_migration_verification_histories_actor_changed")
  @@map("migration_verification_issue_histories")
}

model OperatingMonth {
  id                 String              @id @default(cuid())
  monthKey           String              @unique @map("month_key")
  startDate          DateTime            @map("start_date") @db.Date
  endDate            DateTime            @map("end_date") @db.Date
  status             String              @default("작성중")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  serviceCalls ServiceCall[]
  dailyExpenses DailyExpense[]
  opsAttendances OpsAttendance[]
  therapistAttendances TherapistAttendance[]
  therapistDailySettlementPayments TherapistDailySettlementPayment[]
  monthlyClosings MonthlyClosing[]
  payoutConfirmationEvents PayoutConfirmationEvent[]

  @@map("operating_months")
}

model MonthlyClosing {
  id                   String         @id @default(cuid())
  operatingMonthId     String         @map("operating_month_id")
  operatingMonth       OperatingMonth @relation(fields: [operatingMonthId], references: [id])
  closeVersion         Int            @default(1) @map("close_version")
  snapshotJson         Json           @map("snapshot_json")
  confirmedByAccountId String         @map("confirmed_by_account_id")
  confirmedByAccount   UserAccount    @relation(fields: [confirmedByAccountId], references: [id])
  confirmedAt          DateTime       @map("confirmed_at")
  reopenedAt           DateTime?      @map("reopened_at")
  reopenedByAccountId  String?        @map("reopened_by_account_id")
  reopenReason         String?        @map("reopen_reason")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@unique([operatingMonthId, closeVersion], map: "uq_monthly_closings_month_version")
  @@index([operatingMonthId, closeVersion], map: "idx_monthly_closings_month_version")
  @@index([confirmedAt], map: "idx_monthly_closings_confirmed_at")
  @@index([confirmedByAccountId, confirmedAt], map: "idx_monthly_closings_confirmer_confirmed_at")
  @@map("monthly_closings")
}

model Room {
  id                     String        @id @default(cuid())
  displayName            String        @map("display_name")
  migrationReferenceName String        @map("migration_reference_name")
  sortOrder              Int           @unique @map("sort_order")
  isActive               Boolean       @default(true) @map("is_active")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  serviceCalls           ServiceCall[]

  @@map("rooms")
}

model CodeItem {
  id              String   @id @default(cuid())
  codeType        String   @map("code_type")
  code            String
  displayName     String   @map("display_name")
  sortOrder       Int      @map("sort_order")
  isSystemDefault Boolean  @default(false) @map("is_system_default")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([codeType, code], map: "uq_code_items_code_type_code")
  @@unique([codeType, sortOrder], map: "uq_code_items_code_type_sort_order")
  @@map("code_items")
}

model TimeSlot {
  id        String   @id @default(cuid())
  value     String   @unique
  sortOrder Int      @unique @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("time_slots")
}

model Course {
  id             String                @id @default(cuid())
  code           String                @unique
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  policies       CoursePolicy[]
  therapistRates TherapistCourseRate[]
  serviceCalls   ServiceCall[]

  @@map("courses")
}

model Customer {
  id             String        @id @default(cuid())
  name           String
  phone          String?
  memo           String?
  // 고객 공통 선호·주의사항(F06, 티켓 23). 기존 memo(고객 메모)와는 다른 칸이고, 콜의 비고(note)와도 다르다.
  preferenceNote String?       @map("preference_note")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  serviceCalls   ServiceCall[]

  @@map("customers")
}

model ServiceCall {
  id                String                     @id @default(cuid())
  operatingMonthId  String                     @map("operating_month_id")
  operatingMonth    OperatingMonth             @relation(fields: [operatingMonthId], references: [id])
  serviceDate       DateTime                   @map("service_date") @db.Date
  startTime         String                     @map("start_time")
  actualEntryTime   String?                    @map("actual_entry_time")
  // 실제 종료(1018 스펙 D1·D2, HH:mm). 있으면 Therapist가 이 콜에 묶이는 끝이고, 없으면 표시 종료가 끝이다.
  actualEndTime     String?                    @map("actual_end_time")
  roomId            String?                    @map("room_id")
  room              Room?                      @relation(fields: [roomId], references: [id])
  courseId          String                     @map("course_id")
  course            Course                     @relation(fields: [courseId], references: [id])
  customerId        String?                    @map("customer_id")
  customer          Customer?                  @relation(fields: [customerId], references: [id])
  customerMemo      String?                    @map("customer_memo")
  status            String
  discountTypeCode  String?                    @map("discount_type_code")
  paymentMethodCode String?                    @map("payment_method_code")
  note              String?
  // 이번 콜의 방문별 요청(F06, 티켓 23). note(비고)와는 다른 칸이다.
  visitRequest      String?                    @map("visit_request")
  // 예약 경로(BOOKING_CHANNEL 코드)와 메신저의 예약자명(1018 스펙 D1). 둘 다 비어도 된다.
  bookingChannelCode String?                   @map("booking_channel_code")
  bookerName        String?                    @map("booker_name")
  confirmationCode  String?                    @map("confirmation_code")
  requestId         String?                    @unique @map("request_id")
  // 빠른 예약 일행(스펙 D13, ADR 0007). 일행이 아닌 콜은 둘 다 비어 있다. 순번은 1부터이고 1번이 대표 콜이다.
  partyId           String?                    @map("party_id")
  partyPosition     Int?                       @map("party_position")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  assignments       ServiceCallAssignment[]
  statusHistories   ServiceCallStatusHistory[]

  @@index([operatingMonthId, serviceDate], map: "idx_service_calls_month_date")
  @@index([roomId, serviceDate], map: "idx_service_calls_room_date")
  @@index([status, serviceDate], map: "idx_service_calls_status_date")
  @@index([customerId], map: "idx_service_calls_customer_id")
  @@index([partyId], map: "idx_service_calls_party_id")
  @@map("service_calls")
}

model ServiceCallAssignment {
  id             String      @id @default(cuid())
  serviceCallId  String      @map("service_call_id")
  serviceCall    ServiceCall @relation(fields: [serviceCallId], references: [id])
  employeeId     String      @map("employee_id")
  employee       Employee    @relation(fields: [employeeId], references: [id])
  assignmentRole String      @map("assignment_role")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@unique([serviceCallId, assignmentRole], map: "uq_service_call_assignments_call_role")
  @@index([employeeId, assignmentRole], map: "idx_service_call_assignments_employee_role")
  @@map("service_call_assignments")
}

model ServiceCallStatusHistory {
  id                 String      @id @default(cuid())
  serviceCallId      String      @map("service_call_id")
  serviceCall        ServiceCall @relation(fields: [serviceCallId], references: [id])
  previousStatus     String      @map("previous_status")
  newStatus          String      @map("new_status")
  changedByAccountId String      @map("changed_by_account_id")
  changedByAccount   UserAccount @relation(fields: [changedByAccountId], references: [id])
  changedAt          DateTime    @default(now()) @map("changed_at")
  createdAt          DateTime    @default(now()) @map("created_at")

  @@index([serviceCallId, changedAt], map: "idx_service_call_status_histories_call_changed_at")
  @@index([changedByAccountId, changedAt], map: "idx_service_call_status_histories_actor_changed_at")
  @@map("service_call_status_histories")
}

model DailyExpense {
  id                  String         @id @default(cuid())
  operatingMonthId    String         @map("operating_month_id")
  operatingMonth      OperatingMonth @relation(fields: [operatingMonthId], references: [id])
  expenseDate         DateTime       @map("expense_date") @db.Date
  amount              Int
  description         String
  method              String         @default("cash")
  handledByEmployeeId String         @map("handled_by_employee_id")
  handledByEmployee   Employee       @relation(fields: [handledByEmployeeId], references: [id])
  note                String?
  isActive            Boolean        @default(true) @map("is_active")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([operatingMonthId, expenseDate], map: "idx_daily_expenses_month_date")
  @@index([handledByEmployeeId, expenseDate], map: "idx_daily_expenses_handler_date")
  @@map("daily_expenses")
}

model OpsAttendance {
  id               String         @id @default(cuid())
  operatingMonthId String         @map("operating_month_id")
  operatingMonth   OperatingMonth @relation(fields: [operatingMonthId], references: [id])
  attendanceDate   DateTime       @map("attendance_date") @db.Date
  employeeId       String         @map("employee_id")
  employee         Employee       @relation(fields: [employeeId], references: [id])
  statusCode       String         @map("status_code")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([operatingMonthId, attendanceDate, employeeId], map: "uq_ops_attendances_month_date_employee")
  @@index([employeeId, attendanceDate], map: "idx_ops_attendances_employee_date")
  @@map("ops_attendances")
}

// DB CHECK constraints (declared in the migration, not expressible in Prisma schema):
//   - check_in_minute is a minute-of-day integer in 0..1439
//   - check_out_minute is a nullable minute-of-day integer in 0..1439 (null = 퇴근 미입력)
//   - standby_minutes is the nullable overnight-aware difference in 0..1439 and equals
//     ((check_out_minute - check_in_minute + 1440) % 1440)
//   - is_full_attendance_recognized equals (standby_minutes is not null and standby_minutes >= 600)
model TherapistAttendance {
  id                         String         @id @default(cuid())
  operatingMonthId           String         @map("operating_month_id")
  operatingMonth             OperatingMonth @relation(fields: [operatingMonthId], references: [id])
  attendanceDate             DateTime       @map("attendance_date") @db.Date
  employeeId                 String         @map("employee_id")
  employee                   Employee       @relation(fields: [employeeId], references: [id])
  checkInMinute              Int            @map("check_in_minute")
  // 출근·퇴근에 찍힌 방식(스펙 D16, M23): 직접, 대리 입력, 정정 승인, 이전 기록. 이 칸이 생기기 전
  // 기록은 "이전 기록"이다(가정, D16, 20261020120400 마이그레이션 백필). 퇴근이 없으면 퇴근 방식도 비어 있다.
  checkInMethod              String         @default("이전 기록") @map("check_in_method")
  checkOutMinute             Int?           @map("check_out_minute")
  checkOutMethod             String?        @map("check_out_method")
  standbyMinutes             Int?           @map("standby_minutes")
  isFullAttendanceRecognized Boolean        @map("is_full_attendance_recognized")
  isActive                   Boolean        @default(true) @map("is_active")
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")

  @@unique([operatingMonthId, attendanceDate, employeeId], map: "uq_therapist_attendances_month_date_employee")
  @@index([employeeId, attendanceDate], map: "idx_therapist_attendances_employee_date")
  @@map("therapist_attendances")
}

// 근무표: (직원, 날짜) 한 칸의 근무 예정/휴무 계획. 행이 없으면 미입력이다. 운영월과
// 무관하며(F04), 실제 출퇴근 기록(TherapistAttendance 등)을 만들거나 바꾸지 않는다.
model PlannedWorkingDay {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])
  workDate   DateTime @map("work_date") @db.Date
  planStatus String   @map("plan_status")
  // 출근 예정 시각(1018 스펙 D1·D28, HH:mm). 비어 있으면 종일 근무로 본다.
  plannedStartTime String? @map("planned_start_time")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([employeeId, workDate], map: "uq_planned_working_days_employee_date")
  @@index([workDate], map: "idx_planned_working_days_work_date")
  @@map("planned_working_days")
}

model TherapistDailySettlementPayment {
  id                 String         @id @default(cuid())
  operatingMonthId   String         @map("operating_month_id")
  operatingMonth     OperatingMonth @relation(fields: [operatingMonthId], references: [id])
  serviceDate        DateTime       @map("service_date") @db.Date
  employeeId         String         @map("employee_id")
  employee           Employee       @relation(fields: [employeeId], references: [id])
  isPaid             Boolean        @default(false) @map("is_paid")
  paidAt             DateTime?      @map("paid_at")
  paidByAccountId    String?        @map("paid_by_account_id")
  paidByAccount      UserAccount?   @relation(fields: [paidByAccountId], references: [id])
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  histories          TherapistDailySettlementPaymentHistory[]

  @@unique([operatingMonthId, serviceDate, employeeId], map: "uq_therapist_daily_settlement_payments_month_date_employee")
  @@unique([id, operatingMonthId, serviceDate, employeeId], map: "uq_tdsp_id_month_date_employee")
  @@index([employeeId, serviceDate], map: "idx_therapist_daily_settlement_payments_employee_date")
  @@index([paidByAccountId, paidAt], map: "idx_therapist_daily_settlement_payments_actor_paid_at")
  @@map("therapist_daily_settlement_payments")
}

model TherapistDailySettlementPaymentHistory {
  id                 String                          @id @default(cuid())
  paymentId          String                          @map("payment_id")
  operatingMonthId   String                          @map("operating_month_id")
  serviceDate        DateTime                        @map("service_date") @db.Date
  employeeId         String                          @map("employee_id")
  payment            TherapistDailySettlementPayment @relation(fields: [paymentId, operatingMonthId, serviceDate, employeeId], references: [id, operatingMonthId, serviceDate, employeeId])
  previousIsPaid     Boolean?                        @map("previous_is_paid")
  newIsPaid          Boolean                         @map("new_is_paid")
  changedByAccountId String                          @map("changed_by_account_id")
  changedByAccount   UserAccount                     @relation(fields: [changedByAccountId], references: [id])
  changedAt          DateTime                        @default(now()) @map("changed_at")
  createdAt          DateTime                        @default(now()) @map("created_at")

  @@index([paymentId, changedAt], map: "idx_tdsp_histories_payment_changed")
  @@index([operatingMonthId, serviceDate, employeeId], map: "idx_tdsp_histories_month_date_emp")
  @@index([changedByAccountId, changedAt], map: "idx_tdsp_histories_actor_changed")
  @@map("therapist_daily_settlement_payment_histories")
}

// 지급 확인(ADR 0004, 티켓 30): 두 직군(Therapist·운영팀)의 정산 행 지급 확인을 사건으로 쌓는 공통 저장소.
// 단위는 (unitType, operatingMonthId, serviceDate?, employeeId)이고, serviceDate는 월 단위(운영팀 월 인센)에서 null이다.
// 기존 TherapistDailySettlementPayment(History)의 데이터는 금액 없는 confirm/release 사건으로 이 표에 옮겼다
// (티켓 30 마이그레이션). 옛 표는 과거 기록 보존을 위해 그대로 둔다.
model PayoutConfirmationEvent {
  id               String         @id @default(cuid())
  unitType         String         @map("unit_type")
  operatingMonthId String         @map("operating_month_id")
  operatingMonth   OperatingMonth @relation(fields: [operatingMonthId], references: [id])
  serviceDate      DateTime?      @map("service_date") @db.Date
  employeeId       String         @map("employee_id")
  employee         Employee       @relation(fields: [employeeId], references: [id])
  eventType        String         @map("event_type")
  amount           Int?
  reason           String?
  actorAccountId   String         @map("actor_account_id")
  actorAccount     UserAccount    @relation(fields: [actorAccountId], references: [id])
  occurredAt       DateTime       @map("occurred_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([unitType, operatingMonthId, serviceDate, employeeId, occurredAt], map: "idx_payout_confirmation_events_unit_occurred")
  @@index([actorAccountId, occurredAt], map: "idx_payout_confirmation_events_actor_occurred")
  @@map("payout_confirmation_events")
}

// 티켓 12: 직원 화면의 Therapist 패널에 쌓는 내부 메모(스펙 D27, M24). 관리자만 읽고 쓰고, 추가만 한다
// (수정·삭제 없음). 더하기만 하는 새 표(D29), 운영 DB 적용은 사용자 확인 뒤에 한다.
model TherapistInternalMemo {
  id              String      @id @default(cuid())
  employeeId      String      @map("employee_id")
  employee        Employee    @relation(fields: [employeeId], references: [id])
  authorAccountId String      @map("author_account_id")
  authorAccount   UserAccount @relation(fields: [authorAccountId], references: [id])
  body            String
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([employeeId, createdAt], map: "idx_therapist_internal_memos_employee_created_at")
  @@map("therapist_internal_memos")
}

model CoursePolicy {
  id                      String   @id @default(cuid())
  courseId                String   @map("course_id")
  course                  Course   @relation(fields: [courseId], references: [id])
  name                    String
  durationMinutes         Int      @map("duration_minutes")
  basePrice               Int      @map("base_price")
  requiresSecondTherapist Boolean  @default(false) @map("requires_second_therapist")
  tvDisplayName           String   @map("tv_display_name")
  effectiveFromMonth      String   @map("effective_from_month")
  effectiveToMonth        String?  @map("effective_to_month")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@index([courseId, effectiveFromMonth], map: "idx_course_policies_course_month")
  @@map("course_policies")
}

model TherapistCourseRate {
  id                 String   @id @default(cuid())
  therapistId        String   @map("therapist_id")
  therapist          Employee @relation(fields: [therapistId], references: [id])
  courseId           String   @map("course_id")
  course             Course   @relation(fields: [courseId], references: [id])
  amount             Int
  effectiveFromMonth String   @map("effective_from_month")
  effectiveToMonth   String?  @map("effective_to_month")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([therapistId, courseId, effectiveFromMonth], map: "idx_therapist_course_rates_lookup")
  @@map("therapist_course_rates")
}

model OpsDailyIncentiveRule {
  id                 String   @id @default(cuid())
  thresholdCallCount Int      @map("threshold_call_count")
  personalAmount     Int      @map("personal_amount")
  effectiveFromMonth String   @map("effective_from_month")
  effectiveToMonth   String?  @map("effective_to_month")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([thresholdCallCount, effectiveFromMonth], map: "idx_ops_daily_incentive_rules_lookup")
  @@map("ops_daily_incentive_rules")
}

model OpsMonthlyIncentiveRule {
  id                 String   @id @default(cuid())
  thresholdCallCount Int      @map("threshold_call_count")
  totalAmount        Int      @map("total_amount")
  leadShare          Float    @map("lead_share")
  counterTeamShare   Float    @map("counter_team_share")
  waiterTeamShare    Float    @map("waiter_team_share")
  effectiveFromMonth String   @map("effective_from_month")
  effectiveToMonth   String?  @map("effective_to_month")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([thresholdCallCount, effectiveFromMonth], map: "idx_ops_monthly_incentive_rules_lookup")
  @@map("ops_monthly_incentive_rules")
}

// Therapist 공지(스펙 D25, M24, 티켓 10). 관리자가 Therapist 전체나 특정 Therapist 한 명에게 보낸다.
// 보낸 공지는 고칠 수 없고 내리기만 한다(withdrawnAt). 받는 사람 줄은 TherapistNoticeRecipient에
// 보낼 때 고정한다 — 더하기만 하는 마이그레이션이다(D29).
model TherapistNotice {
  id                   String                     @id @default(cuid())
  authorAccountId      String                     @map("author_account_id")
  authorAccount        UserAccount                @relation("TherapistNoticeAuthor", fields: [authorAccountId], references: [id])
  body                 String
  // "전체" | "특정"(CONTEXT.md 공지 용어). "특정"일 때만 targetEmployeeId가 있다.
  targetType           String                     @map("target_type")
  targetEmployeeId     String?                    @map("target_employee_id")
  targetEmployee       Employee?                  @relation(fields: [targetEmployeeId], references: [id])
  sentAt               DateTime                   @default(now()) @map("sent_at")
  withdrawnAt          DateTime?                   @map("withdrawn_at")
  withdrawnByAccountId String?                     @map("withdrawn_by_account_id")
  withdrawnByAccount   UserAccount?               @relation("TherapistNoticeWithdrawnBy", fields: [withdrawnByAccountId], references: [id])
  createdAt            DateTime                   @default(now()) @map("created_at")
  recipients           TherapistNoticeRecipient[]

  @@index([sentAt], map: "idx_therapist_notices_sent_at")
  @@map("therapist_notices")
}

// 공지 받는 사람 줄: 보낼 때의 활성 Therapist 계정 기준으로 한 번 만들고 바뀌지 않는다.
// readAt이 비어 있으면 안 읽음이다(스펙 D25).
model TherapistNoticeRecipient {
  id         String          @id @default(cuid())
  noticeId   String          @map("notice_id")
  notice     TherapistNotice @relation(fields: [noticeId], references: [id])
  employeeId String          @map("employee_id")
  employee   Employee        @relation(fields: [employeeId], references: [id])
  readAt     DateTime?       @map("read_at")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([noticeId, employeeId], map: "uq_therapist_notice_recipients_notice_employee")
  @@index([employeeId, readAt], map: "idx_therapist_notice_recipients_employee_read")
  @@map("therapist_notice_recipients")
}
